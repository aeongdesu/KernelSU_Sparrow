+            return Ok(kmi);
+        }
+        // Vendor releases such as `5.10.198-perf-<sha>` carry no androidNN tag,
+        // so neither probe can succeed. Use the single KMI the loader embeds.
+        let embedded = crate::assets::list_supported_kmi();
+        match embedded.len() {
+            1 => Ok(embedded[0].clone()),
+            0 => bail!("no kernel module embedded"),
+            _ => bail!("cannot detect KMI; {} modules embedded", embedded.len()),
+        }
